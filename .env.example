NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# used to decide what "a day" means for search and analytics
APP_TIMEZONE=Asia/Kolkata

DATABASE_URL=postgres://amrutam:amrutam@localhost:5432/amrutam
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=5000
# optional - without it cache and rate limits are per process
REDIS_URL=redis://localhost:6379

# generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
REQUIRE_ADMIN_MFA=true

# comma separated version:base64(32 bytes). New data is written with the active version.
# generate a key with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEYS=v1:REPLACE_WITH_32_BYTE_BASE64_KEY
DATA_ENCRYPTION_ACTIVE_KEY=v1

PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
BOOKING_HOLD_MINUTES=10
CANCELLATION_CUTOFF_HOURS=2

CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
MIGRATE_ON_START=false
